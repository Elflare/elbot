// 职责：保留尚未迁移的命名状态、构造及默认标题参考。
// TODO(naming阶段)：仅保留命名状态、构造及 defaultTitle 的迁移参考，Naming 完成后删除本备份。
package session

import (
	"strings"
	"sync"
	"unicode/utf8"

	"elbot/internal/signal"
	"elbot/internal/storage"
)

type Service struct {
	store          storage.Store
	mu             sync.Mutex
	namingConfig   NamingConfig
	titleGen       TitleGenerator
	namingSignals  NamingSignals
	logConnections []*signal.Connection
	namingStates   map[string]namingState
	naming         namingLifecycle
}

func NewServiceWithNaming(store storage.Store, cfg NamingConfig, titleGen TitleGenerator) *Service {
	s := &Service{
		store:         store,
		namingConfig:  cfg,
		titleGen:      titleGen,
		namingSignals: newNamingSignals(),
		namingStates:  map[string]namingState{},
		naming:        namingLifecycle{done: make(chan struct{})},
	}
	s.connectLogSignals()
	return s
}

func defaultTitle(text string) string {
	text = strings.TrimSpace(text)
	if text == "" {
		return "New session"
	}
	const maxRunes = 40
	if utf8.RuneCountInString(text) <= maxRunes {
		return text
	}
	runes := []rune(text)
	return string(runes[:maxRunes]) + "..."
}
