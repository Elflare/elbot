// 职责：验证命名事件、手动改名竞争及事件数据隔离。
// TODO(session重构)：待迁移到 naming/naming.go、naming/signals.go 的相应测试，迁移完成后删除本备份。
package session

import (
	"context"
	"errors"
	"testing"
	"time"

	"elbot/internal/contextinfo"
	"elbot/internal/events"
	"elbot/internal/signal"
	"elbot/internal/storage"
)

type failedNamingMessages struct {
	storage.MessageRepository
	err error
}

func (r failedNamingMessages) ListBySession(context.Context, string) ([]storage.Message, error) {
	return nil, r.err
}

func TestNamingPreparationFailureHasUnscheduledCompletion(t *testing.T) {
	store := newTestStore(t)
	original := errors.New("read messages failed")
	svc := NewServiceWithNaming(namingPreparationStore{store, failedNamingMessages{store.Messages(), original}}, NamingConfig{TriggerStep: 1}, namingGeneratorFunc(func(context.Context, []storage.Message) (TitleResult, error) {
		t.Error("generator must not run")
		return TitleResult{}, nil
	}))
	startTestNaming(t, svc)
	var got NamingCompletedEvent
	scheduled := 0
	c, err := svc.NamingSignals().Scheduled.Observe(func(context.Context, NamingScheduledEvent) error { scheduled++; return nil }, signal.ConnectOptions{})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(c.Disconnect)
	c, err = svc.NamingSignals().Completed.Observe(func(_ context.Context, e NamingCompletedEvent) error { got = e; return nil }, signal.ConnectOptions{})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(c.Disconnect)
	ctx := contextinfo.WithExecution(context.Background(), contextinfo.Execution{SessionID: "wrong", RunID: "run", RequestID: "request"})
	svc.MaybeScheduleNaming(ctx, "source")
	if scheduled != 0 || got.Scheduled || got.MessageCount != nil || got.PreparationError != original || got.PreparationResultStatus != events.ResultFailed || got.ResultStatus != events.ResultFailed || got.GenerationResultStatus != events.ResultUnspecified || got.CompletedAt.Before(got.TriggeredAt) {
		t.Fatalf("preparation facts: %+v", got)
	}
	if got.Identity.SessionID == nil || *got.Identity.SessionID != "source" || got.Identity.RequestID == nil || *got.Identity.RequestID != "request" {
		t.Fatalf("identity: %+v", got.Identity)
	}
}

func TestNamingManualRenameDuringGenerationIsSkipped(t *testing.T) {
	store := newTestStore(t)
	started, release := make(chan struct{}), make(chan struct{})
	svc := NewServiceWithNaming(store, NamingConfig{TriggerStep: 1}, namingGeneratorFunc(func(context.Context, []storage.Message) (TitleResult, error) {
		close(started)
		<-release
		return TitleResult{RawTitle: "generated title", Provider: "provider", Model: "model"}, nil
	}))
	startTestNaming(t, svc)
	row := namingRow(t, svc, store)
	completed := make(chan NamingCompletedEvent, 1)
	c, err := svc.NamingSignals().Completed.Observe(func(_ context.Context, e NamingCompletedEvent) error { completed <- e; return nil }, signal.ConnectOptions{})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(c.Disconnect)
	svc.MaybeScheduleNaming(context.Background(), row.ID)
	<-started
	_, err = store.Sessions().Mutate(context.Background(), row.ID, func(row *storage.Session) error {
		row.Title = "manual title"
		row.Metadata = `{"title_renamed":true}`
		return nil
	})
	close(release)
	if err != nil {
		t.Fatal(err)
	}
	select {
	case got := <-completed:
		if got.ResultStatus != events.ResultSkipped || got.GenerationResultStatus != events.ResultSucceeded || got.PersistenceResultStatus != events.ResultSkipped || got.GeneratedTitleRaw != "generated title" || got.Title == nil || *got.Title != "manual title" || got.FallbackResultStatus != events.ResultUnspecified {
			t.Fatalf("rename facts: %+v", got)
		}
	case <-time.After(time.Second):
		t.Fatal("no terminal event")
	}
}

func TestNamingCompletionCopiesOptionalFields(t *testing.T) {
	svc := NewService(nil)
	defer svc.Close(context.Background())
	var got NamingCompletedEvent
	c, err := svc.NamingSignals().Completed.Observe(func(_ context.Context, e NamingCompletedEvent) error { got = e; return nil }, signal.ConnectOptions{})
	if err != nil {
		t.Fatal(err)
	}
	defer c.Disconnect()
	id, title, count, valid := "session", "title", 3, true
	svc.notifyNamingCompleted(context.Background(), NamingCompletedEvent{Identity: events.LogIdentity{SessionID: &id}, Title: &title, MessageCount: &count, TitleValid: &valid})
	id, title, count, valid = "changed", "changed", 9, false
	if *got.Identity.SessionID != "session" || *got.Title != "title" || *got.MessageCount != 3 || !*got.TitleValid {
		t.Fatalf("mutable snapshot: %+v", got)
	}
}
